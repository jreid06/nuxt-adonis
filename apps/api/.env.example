# Node
TZ=UTC
PORT=3333
HOST=localhost
NODE_ENV=development
LOG_LEVEL=info

# App
APP_KEY=zKXHe-Ahdb7aPK1ylAJlRgTefktEaACi
APP_URL=http://${HOST}:${PORT}

#--------------------------------------------------------------------
# Database (Postgres, via Drizzle) — matches docker-compose.yml at the
# repo root when running the stack locally with `docker compose up -d`
#--------------------------------------------------------------------
DATABASE_URL=postgres://postgres:postgres@localhost:5432/app

#--------------------------------------------------------------------
# CORS — comma separated list of allowed origins in production.
# Ignored in development, where every origin is allowed.
#--------------------------------------------------------------------
CORS_ORIGIN=http://localhost:3000

#--------------------------------------------------------------------
# Stripe — from the Stripe dashboard (test mode keys while developing)
#--------------------------------------------------------------------
STRIPE_SECRET_KEY=#sk_test_xxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=#whsec_xxxxxxxxxxxxxxxxxxxxxxxx
